{
  "_version": "1.65.0",
  "sap.app": {
    "id": "com.riotinto.btp.ms.batchmerge",
    "type": "application",
    "title": "Batch Merge",
    "description": "Merge batch splits into a single delivery batch with weighted average characteristics",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": { "version": "1.0.0" },
    "dataSources": {
      "DeliveryService": {
        "uri": "/delivery/",
        "type": "OData",
        "settings": { "odataVersion": "4.0" }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5"
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.fe.templates": {}
      }
    },
    "routing": {
      "config": { "routerClass": "sap.fe.core.AppRouter" },
      "routes": [
        {
          "name": "OutboundDeliveriesList",
          "pattern": "",
          "target": "OutboundDeliveriesList"
        },
        {
          "name": "OutboundDeliveriesObjectPage",
          "pattern": "OutboundDeliveries({key})",
          "target": "OutboundDeliveriesObjectPage"
        }
      ],
      "targets": {
        "OutboundDeliveriesList": {
          "type": "Component",
          "id": "OutboundDeliveriesList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "entitySet": "OutboundDeliveries",
              "contextPath": "/OutboundDeliveries",
              "variantManagement": "Page"
            }
          }
        },
        "OutboundDeliveriesObjectPage": {
          "type": "Component",
          "id": "OutboundDeliveriesObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "entitySet": "OutboundDeliveries",
              "contextPath": "/OutboundDeliveries"
            }
          }
        }
      }
    }
  }
}
