{
  "name": "com-riotinto-btp-ms-batchmerge",
  "version": "1.0.0",
  "description": "CAP application for merging batch splits on Outbound Delivery Items",
  "repository": "<Add your repository here>",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@sap/cds": "^9",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.1",
    "@cap-js/sqlite": "^2.4.0",
    "@sap/cds-dk": "^9.9.2",
    "jest": "^30.4.2"
  },
  "scripts": {
    "start": "cds run",
    "test": "jest --testPathPattern=test/"
  },
  "jest": {
    "testEnvironment": "node"
  },
  "cds": {
    "requires": {
      "auth": {
        "[production]": { "kind": "ams" },
        "kind": "mocked"
      },
      "ZAPI_OUTBOUND_DELIVERY_SRV2": {
        "kind": "odata-v2",
        "model": "srv/external/ZAPI_OUTBOUND_DELIVERY_SRV2",
        "credentials": {
          "destination": "RD1CLNT510_HTTPS",
          "path": "/sap/opu/odata/sap/API_OUTBOUND_DELIVERY_SRV;v=0002"
        }
      },
      "S4_HTTP": {
        "kind": "rest",
        "credentials": {
          "destination": "RD1CLNT510_HTTPS"
        }
      }
    }
  }
}
